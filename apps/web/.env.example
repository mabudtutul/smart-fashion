# Storefront catalog backend: pb (default) | laravel
VITE_BACKEND_DRIVER=pb

# Admin catalog reads: pb (default) | laravel (requires VITE_API_BASE_URL)
VITE_ADMIN_CATALOG_DRIVER=pb

# Admin image uploads: pb (default) | laravel (requires VITE_API_BASE_URL + Laravel login bridge)
VITE_ADMIN_MEDIA_DRIVER=pb

# PocketBase — required for admin + blog while PB is still connected (no trailing slash).
VITE_POCKETBASE_URL=https://your-pocketbase-url.up.railway.app

# Laravel API — required when VITE_BACKEND_DRIVER=laravel (no trailing slash).
VITE_API_BASE_URL=https://api.smartfashion.site
