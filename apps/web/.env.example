# ── Production contract (mirror apps/web/.env.production) ───────────────────
# Single API base: full /api/v1 path. Site origin is derived in src/lib/catalog/config.js
VITE_BACKEND_DRIVER=laravel
VITE_ADMIN_CATALOG_DRIVER=laravel
VITE_ADMIN_MEDIA_DRIVER=laravel
VITE_API_BASE_URL=https://smartfashion.site/api/v1
VITE_POCKETBASE_URL=

# Do NOT set VITE_API_URL or VITE_BACKEND_URL — deprecated split bases.
# PocketBase driver removed Phase 2 — Laravel only.
