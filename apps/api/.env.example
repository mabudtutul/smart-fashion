APP_NAME="Smart Fashion API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://api.smartfashion.site

# Shared hosting: set APP_ENV=production, APP_DEBUG=false on server.
# API subdomain docroot = public/ (contains index.php + uploads/).
# Do NOT run php artisan storage:link — use public/uploads/ directly.

LOG_CHANNEL=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartfashion
DB_USERNAME=root
DB_PASSWORD=

# Hostinger: use hPanel MySQL credentials; DB_HOST is often 127.0.0.1 on-server.

BROADCAST_CONNECTION=log
CACHE_STORE=database
FILESYSTEM_DISK=uploads

# Media pipeline (sync upload-time WebP variants; no queue)
MEDIA_MAX_UPLOAD_KB=8192
MEDIA_MAX_EDGE_PX=4000
MEDIA_MIN_EDGE_PX=200
MEDIA_WEBP_QUALITY=80
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=smartfashion.site,www.smartfashion.site,localhost,127.0.0.1

# Comma-separated origins allowed by CORS (SPA storefront + local dev).
CORS_ALLOWED_ORIGINS=https://smartfashion.site,https://www.smartfashion.site,http://localhost:5173

FRONTEND_URL=https://smartfashion.site

# PocketBase → Laravel import (php artisan catalog:import-pocketbase)
# PB_IMPORT_PRODUCTS_COLLECTION_ID=pbc_7792861864
# PB_IMPORT_CATEGORIES_COLLECTION_ID=pbc_4272526527
