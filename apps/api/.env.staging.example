APP_NAME="Smart Fashion API (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://staging-api.smartfashion.site

LOG_CHANNEL=daily
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=REPLACE_STAGING_DB_NAME
DB_USERNAME=REPLACE_STAGING_DB_USER
DB_PASSWORD=REPLACE_STAGING_DB_PASSWORD

BROADCAST_CONNECTION=log
CACHE_STORE=database
FILESYSTEM_DISK=uploads
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEDIA_MAX_UPLOAD_KB=8192
MEDIA_MAX_EDGE_PX=4000
MEDIA_MIN_EDGE_PX=200
MEDIA_WEBP_QUALITY=80

SANCTUM_STATEFUL_DOMAINS=smartfashion.site,www.smartfashion.site,localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=https://smartfashion.site,https://www.smartfashion.site,http://localhost:5173

FRONTEND_URL=https://smartfashion.site

